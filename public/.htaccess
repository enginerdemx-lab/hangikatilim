Options -MultiViews
RewriteEngine On
RewriteBase /

# ===== Cache Control Headers =====
# index.html - NO CACHE (always fetch fresh)
<FilesMatch "index\.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# Assets (JS, CSS, images with hash) - IMMUTABLE (long cache)
<FilesMatch "\.(js|css|woff2?|eot|ttf|otf|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ===== CRITICAL: Exclude static assets from SPA fallback =====
# If request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# If request is for /assets/ and file doesn't exist, return 404 (NOT index.html)
RewriteCond %{REQUEST_URI} ^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

# ===== SPA Routing Fallback =====
# For all other routes (non-existing files), serve index.html
# This enables React Router client-side routing
RewriteRule ^ index.html [L]
