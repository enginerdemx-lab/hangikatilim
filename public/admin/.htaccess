<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  # 1. Eğer istek fiziksel bir dosya veya klasör ise, onu doğrudan servis et
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Tüm diğer istekleri (sanal yolları) ana dizindeki React SPA'ya yönlendir
  RewriteRule ^(.*)$ ../index.html [L]
</IfModule>
